.zsh_history
**/.zsh_history
.config/envman/
.env
.env.*
*.pem
*.key

# Matugen output (regenerated whenever a wallpaper is selected)
/waybar/.config/waybar/matugen.css
/kitty/.config/kitty/colors.conf
/fastfetch/.config/fastfetch/matugen.jsonc
/wofi/.config/wofi/matugen.css
/hypr/.config/hypr/hyprlock-matugen.conf
/hypr/.config/hypr/matugen-colors.lua
/gtk/.config/gtk-3.0/gtk.css

# Local pre-Matugen fallback copies
/waybar/.config/waybar/*.backup
/kitty/.config/kitty/*.backup
