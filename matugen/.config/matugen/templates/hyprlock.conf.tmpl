# GENERATED FILE — DO NOT EDIT. Edit the Matugen template instead.
background {
    monitor =
    path = /home/dana/.cache/matugen/lockscreen-wallpaper
    color = {{colors.background.dark.rgba}}
    blur_passes = 0
    brightness = 2.2
}

# DATE
label {
    monitor = DP-1
    size = 30, 30
    color = {{colors.on_surface.dark.rgba | set_alpha: 0.85}} # no fill
    text = cmd[update:1000] echo "$(date +"%A, %B %d")"
    border_color = {{colors.primary.dark.rgba}}
    font_size = 25
    font_family = Iosevka Nerd Font

    position = 0, -210
    halign = center
    valign = center
}

# TIME
label {
    monitor = DP-1
    size = 30, 30
    color = {{colors.on_surface.dark.rgba | set_alpha: 0.85}} # no fill
    text = $TIME12
    border_color = {{colors.primary.dark.rgba}}
    font_size = 60
    font_family = Iosevka Nerd Font

    position = 0, -130
    halign = center
    valign = center
}

image {
    monitor = DP-1
    size = 450
    path = /home/dana/.cache/matugen/lockscreen-wallpaper
    zindex = 2
    border_color = rgba(0, 0, 0, 0.0)
    shadow_passes = 1

    position = 0, 200
    halign = center
    valign = center
}

shape {
    monitor = DP-1
    size = 450
    zindex = 1
    border_color = rgba(0, 0, 0, 0.1)

    position = 0, 200
    halign = center
    valign = center
}

input-field {
    monitor = DP-1
    size = 500, 500
    outline_thickness = 10
    inner_color = {{colors.surface_container.dark.rgba | set_alpha: 0.25}} # no fill
    outer_color = {{colors.primary.dark.rgba}} {{colors.secondary.dark.rgba}} 45deg
    check_color = {{colors.tertiary.dark.rgba}} {{colors.secondary.dark.rgba}} 120deg
    fail_color = {{colors.error.dark.rgba}} {{colors.error_container.dark.rgba}} 40deg

    font_color = {{colors.on_surface_variant.dark.rgba}}
    fade_on_empty = false
    rounding = -1
    hide_input = true
    placeholder_text =
    fail_text =
    fail_timeout = 1000
    dots_size = 0.2

    position = 0, 200
    halign = center
    valign = center
}
