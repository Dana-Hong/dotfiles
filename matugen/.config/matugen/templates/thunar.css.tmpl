/* Generated by Matugen. Edit the template, not ~/.config/gtk-3.0/gtk.css. */

/* Keep these overrides scoped to Thunar so unrelated GTK applications retain
 * their native theme behavior. */
thunar-window,
window.thunar {
    background-color: {{colors.surface.dark.hex}};
    color: {{colors.on_surface.dark.hex}};
}

thunar-window headerbar,
thunar-window toolbar,
thunar-window menubar,
window.thunar headerbar,
window.thunar toolbar,
window.thunar menubar {
    background-color: {{colors.surface_container.dark.hex}};
    color: {{colors.on_surface.dark.hex}};
    border-color: {{colors.outline_variant.dark.rgba | set_alpha: 0.65}};
    background-image: none;
    box-shadow: none;
}

thunar-window .standard-view,
thunar-window .standard-view .view,
window.thunar .standard-view,
window.thunar .standard-view .view {
    background-color: {{colors.surface.dark.hex}};
    color: {{colors.on_surface.dark.hex}};
}

thunar-window .sidebar,
thunar-window .sidebar .view,
window.thunar .sidebar,
window.thunar .sidebar .view {
    background-color: {{colors.surface_container_low.dark.hex}};
    color: {{colors.on_surface_variant.dark.hex}};
    border-color: {{colors.outline_variant.dark.rgba | set_alpha: 0.55}};
}

thunar-window .view:selected,
thunar-window .standard-view .view:selected,
thunar-window .sidebar .view:selected,
window.thunar .view:selected,
window.thunar .standard-view .view:selected,
window.thunar .sidebar .view:selected {
    background-color: {{colors.primary_container.dark.hex}};
    color: {{colors.on_primary_container.dark.hex}};
    outline-color: {{colors.primary.dark.rgba | set_alpha: 0.8}};
}

thunar-window entry,
window.thunar entry {
    background-color: {{colors.surface_container_high.dark.hex}};
    color: {{colors.on_surface.dark.hex}};
    border-color: {{colors.outline_variant.dark.rgba | set_alpha: 0.7}};
    caret-color: {{colors.primary.dark.hex}};
    background-image: none;
}

thunar-window entry:focus,
window.thunar entry:focus {
    border-color: {{colors.primary.dark.hex}};
    box-shadow: inset 0 0 0 1px {{colors.primary.dark.rgba | set_alpha: 0.65}};
}

thunar-window button,
thunar-window .location-button,
window.thunar button,
window.thunar .location-button {
    background-color: {{colors.surface_container_high.dark.hex}};
    color: {{colors.on_surface.dark.hex}};
    border-color: {{colors.outline_variant.dark.rgba | set_alpha: 0.55}};
    background-image: none;
    box-shadow: none;
}

thunar-window button:hover,
thunar-window .location-button:hover,
window.thunar button:hover,
window.thunar .location-button:hover {
    background-color: {{colors.secondary_container.dark.hex}};
    color: {{colors.on_secondary_container.dark.hex}};
    border-color: {{colors.secondary.dark.rgba | set_alpha: 0.75}};
}

thunar-window button:checked,
thunar-window button:active,
window.thunar button:checked,
window.thunar button:active {
    background-color: {{colors.primary_container.dark.hex}};
    color: {{colors.on_primary_container.dark.hex}};
    border-color: {{colors.primary.dark.rgba | set_alpha: 0.8}};
}

thunar-window separator,
window.thunar separator {
    background-color: {{colors.outline_variant.dark.rgba | set_alpha: 0.5}};
}

thunar-window scrollbar trough,
window.thunar scrollbar trough {
    background-color: {{colors.surface_container_low.dark.rgba | set_alpha: 0.7}};
}

thunar-window scrollbar slider,
window.thunar scrollbar slider {
    min-width: 8px;
    min-height: 8px;
    background-color: {{colors.outline.dark.rgba | set_alpha: 0.75}};
    border-radius: 999px;
}

thunar-window scrollbar slider:hover,
window.thunar scrollbar slider:hover {
    background-color: {{colors.primary.dark.rgba | set_alpha: 0.85}};
}

thunar-window statusbar,
window.thunar statusbar {
    background-color: {{colors.surface_container.dark.hex}};
    color: {{colors.on_surface_variant.dark.hex}};
}
