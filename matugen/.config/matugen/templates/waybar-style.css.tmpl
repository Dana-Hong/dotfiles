
* {
    /* `otf-font-awesome` is required to be installed for icons */
    font-family:
        Iosevka Nerd Font,
        FontAwesome,
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
    font-size: 16px;
    font-weight: 600;
}

window#waybar {
    border-bottom-style: solid;
    border-bottom-width: 3px;
    transition-property: background-color;
    transition-duration: 0.5s;
}

window#waybar.hidden {
    opacity: 0.3;
}

window#waybar.chromium {
    border: none;
}

button {
    /* Use box-shadow instead of border so the text isn't offset */
    box-shadow: inset 0 -3px transparent;
    border: none;
    border-radius: 0;
}

/* https://github.com/Alexays/Waybar/wiki/FAQ#the-workspace-buttons-have-a-strange-hover-effect */
#workspaces button {
    padding: 0 10px;
}

#clock,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#pulseaudio,
#wireplumber,
#custom-media,
#tray,
#mode,
#idle_inhibitor,
#scratchpad,
#power-profiles-daemon,
#mpd {
    padding: 5px 15px;
}

#window {
    font-weight: 700;
    font-size: 90px;
}

#workspaces {
    margin: 0 4px;
}

.modules-left > widget:first-child > #workspaces {
    margin-left: 0;
}

.modules-right > widget:last-child > #workspaces {
    margin-right: 0;
}

/* Using steps() instead of linear as a timing function to limit CPU usage */
#battery.critical:not(.charging) {
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: steps(12);
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

#power-profiles-daemon {
    padding-right: 15px;
}

#custom-media {
    min-width: 100px;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
}

#language {
    padding: 0 5px;
    margin: 0 5px;
    min-width: 16px;
}

#keyboard-state {
    padding: 0;
    margin: 0 5px;
    min-width: 16px;
}

#keyboard-state > label {
    padding: 0 5px;
}

#privacy {
    padding: 0;
}

#privacy-item {
    padding: 0 5px;
}

/* Generated by Matugen. Edit the template, not this file. */
window#waybar {
    background-color: {{colors.background.dark.hex}};
    border-bottom-color: {{colors.primary.dark.hex}};
    color: {{colors.on_surface.dark.hex}};
}

window#waybar.termite,
label:focus {
    background-color: {{colors.surface_container.dark.hex}};
}

window#waybar.chromium {
    background-color: {{colors.background.dark.hex}};
}

button {
    color: {{colors.on_surface.dark.hex}};
}

button:hover,
#pulseaudio:hover,
#workspaces button:hover {
    background-color: {{colors.surface_container_high.dark.hex}};
    box-shadow: inset 0 -3px {{colors.primary.dark.hex}};
}

#workspaces button {
    background-color: transparent;
    color: {{colors.on_surface_variant.dark.hex}};
}

#workspaces button:hover {
    color: {{colors.on_surface.dark.hex}};
}

#workspaces button.focused,
#workspaces button.active {
    background-color: {{colors.primary_container.dark.hex}};
    color: {{colors.on_primary_container.dark.hex}};
    box-shadow: inset 0 -3px {{colors.primary.dark.hex}};
}

#workspaces button.urgent {
    background-color: {{colors.error_container.dark.hex}};
    color: {{colors.on_error_container.dark.hex}};
}

#mode,
#backlight,
#custom-media,
#custom-media.custom-spotify,
#mpd,
#power-profiles-daemon.power-saver,
#language,
#keyboard-state,
#privacy-item.audio-in {
    background-color: {{colors.secondary_container.dark.hex}};
    color: {{colors.on_secondary_container.dark.hex}};
}

#clock,
#cpu,
#memory,
#network,
#pulseaudio,
#temperature,
#scratchpad.empty {
    background-color: transparent;
    color: {{colors.on_surface.dark.hex}};
}

#window,
#privacy-item {
    color: {{colors.on_surface.dark.hex}};
}

@keyframes blink {
    to {
        background-color: {{colors.error.dark.hex}};
        color: {{colors.on_error.dark.hex}};
    }
}

#battery.critical:not(.charging),
#power-profiles-daemon.performance,
#network.disconnected,
#wireplumber.muted,
#temperature.critical,
#mpd.disconnected,
#tray > .needs-attention {
    background-color: {{colors.error_container.dark.hex}};
    color: {{colors.on_error_container.dark.hex}};
}

#power-profiles-daemon.balanced,
#tray,
#privacy-item.audio-out {
    background-color: {{colors.primary_container.dark.hex}};
    color: {{colors.on_primary_container.dark.hex}};
}

#disk,
#custom-media.custom-vlc,
#privacy-item.screenshare {
    background-color: {{colors.tertiary_container.dark.hex}};
    color: {{colors.on_tertiary_container.dark.hex}};
}

#pulseaudio.muted,
#mpd.stopped {
    background-color: {{colors.surface_container_high.dark.hex}};
    color: {{colors.on_surface_variant.dark.hex}};
}

#wireplumber,
#idle_inhibitor {
    background-color: {{colors.surface_container.dark.hex}};
    color: {{colors.on_surface_variant.dark.hex}};
}

#idle_inhibitor.activated {
    background-color: {{colors.primary.dark.hex}};
    color: {{colors.on_primary.dark.hex}};
}

#mpd.paused {
    background-color: {{colors.secondary.dark.hex}};
    color: {{colors.on_secondary.dark.hex}};
}

#keyboard-state > label.locked {
    background-color: {{colors.secondary.dark.hex}};
    color: {{colors.on_secondary.dark.hex}};
}

#scratchpad {
    background-color: {{colors.tertiary_container.dark.hex}};
    color: {{colors.on_tertiary_container.dark.hex}};
}
