# Generated by Matugen. Edit this template, not ~/.config/starship.toml.
palette = "matugen"

format = """
[](fg:background)\
[  ](bg:background fg:primary)\
$directory\
[ ](fg:background)\
$git_branch\
$git_status\
$nodejs\
$rust\
$golang\
$php\
$python\
$time\
\n$character"""

[palettes.matugen]
background = "{{colors.background.dark.hex}}"
foreground = "{{colors.on_surface.dark.hex}}"
primary = "{{colors.primary.dark.hex}}"
primary_container = "{{colors.primary_container.dark.hex}}"
on_primary_container = "{{colors.on_primary_container.dark.hex}}"
secondary_container = "{{colors.secondary_container.dark.hex}}"
on_secondary_container = "{{colors.on_secondary_container.dark.hex}}"
tertiary_container = "{{colors.tertiary_container.dark.hex}}"
on_tertiary_container = "{{colors.on_tertiary_container.dark.hex}}"
error = "{{colors.error.dark.hex}}"

[directory]
style = "fg:foreground bg:background"
format = "[ $path]($style)"
truncation_length = 10
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "

[git_branch]
symbol = ""
format = "[](fg:primary_container)[ $symbol $branch](fg:on_primary_container bg:primary_container)"

[git_status]
up_to_date = "✓"
format = "[ $all_status$ahead_behind ](fg:on_primary_container bg:primary_container)[ ](fg:primary_container)"

[nodejs]
symbol = ""
format = "[](fg:secondary_container)[ $symbol ($version) ](fg:on_secondary_container bg:secondary_container)[ ](fg:secondary_container)"

[rust]
symbol = ""
format = "[](fg:secondary_container)[ $symbol ($version) ](fg:on_secondary_container bg:secondary_container)[ ](fg:secondary_container)"

[golang]
symbol = ""
format = "[](fg:secondary_container)[ $symbol ($version) ](fg:on_secondary_container bg:secondary_container)[ ](fg:secondary_container)"

[php]
symbol = ""
format = "[](fg:secondary_container)[ $symbol ($version) ](fg:on_secondary_container bg:secondary_container)[ ](fg:secondary_container)"

[python]
symbol = "🐍"
format = "[](fg:secondary_container)[ $symbol ($version) ](fg:on_secondary_container bg:secondary_container)[ ](fg:secondary_container)"

[time]
disabled = false
time_format = "%l:%M %p"
format = "[](fg:tertiary_container)[   $time ](fg:on_tertiary_container bg:tertiary_container)[ ](fg:tertiary_container)"

[character]
success_symbol = "[❯](bold primary)"
error_symbol = "[❯](bold error)"
vimcmd_symbol = "[❮](bold primary)"
